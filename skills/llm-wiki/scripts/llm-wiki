#!/bin/sh
# llm-wiki-cli
set -eu

VERSION=0.2.0
ROOT=.

usage() {
  cat <<'EOF'
Usage:
  llm-wiki init [--root DIR] [--name NAME] [--purpose TEXT] [--language LANG]
                [--areas CSV] [--fields CSV] [--force]
  llm-wiki import document SOURCE [--root DIR] [--name NAME]
  llm-wiki import repo SOURCE [--root DIR] [--name NAME]
  llm-wiki import memory SOURCE [--root DIR] [--name NAME]
  llm-wiki memory remember NAME [--root DIR] [--content TEXT | --file FILE]
                           [--summary TEXT] [--topics CSV]
  llm-wiki memory update NAME [--root DIR] [--content TEXT | --file FILE]
                         [--summary TEXT] [--topics CSV]
  llm-wiki memory recall QUERY [--root DIR] [--limit N]
  llm-wiki memory inbox SOURCE [--root DIR] [--source LABEL]
  llm-wiki memory list [--root DIR]
  llm-wiki status [--root DIR]
  llm-wiki version
EOF
}

die() { printf 'llm-wiki: %s\n' "$*" >&2; exit 1; }

safe_name() {
  value=$(printf '%s' "$1" | sed 's/[?#].*$//' | sed 's:/*$::' | sed 's:.*/::' | sed 's/\.git$//' | tr ' ' '-' | sed 's:[/\\]:-:g; s/^[-.]*//; s/[-.]*$//')
  [ -n "$value" ] || value=source
  printf '%s\n' "$value"
}

yaml_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

absolute_root() {
  mkdir -p "$ROOT"
  ROOT=$(CDPATH= cd -- "$ROOT" && pwd)
}

config_value() {
  key=$1
  sed -n "s/^${key}=//p" "$ROOT/.llm-wiki/config" | head -n 1
}

require_initialized() {
  [ -f "$ROOT/LLM-WIKI.md" ] && [ -f "$ROOT/.llm-wiki/config" ] || die "$ROOT is not initialized; run 'llm-wiki init' first"
}

ensure_memory_dirs() {
  mkdir -p "$ROOT/wiki/memory" "$ROOT/.llm-wiki/private-inbox"
  [ -f "$ROOT/.llm-wiki/private-inbox/.gitignore" ] || printf '*\n!.gitignore\n' > "$ROOT/.llm-wiki/private-inbox/.gitignore"
}

validate_registry_field() {
  case "$2" in *"$(printf '\t')"*) die "$1 cannot contain tabs or newlines" ;; esac
  [ "$(printf '%s\n' "$2" | wc -l | tr -d ' ')" -eq 1 ] || die "$1 cannot contain tabs or newlines"
}

append_agents_block() {
  agents=$ROOT/AGENTS.md
  marker='<!-- LLM-WIKI:START -->'
  if [ -f "$agents" ] && grep -Fq "$marker" "$agents"; then return; fi
  if [ -s "$agents" ]; then printf '\n' >> "$agents"; fi
  cat >> "$agents" <<'EOF'
<!-- LLM-WIKI:START -->
## LLM Wiki

- Read `LLM-WIKI.md` before changing knowledge structure.
- Search `wiki/` before reading `raw/` or creating a page.
- Keep imported source material immutable under `raw/`.
- Put durable, reusable knowledge under `wiki/` with the configured frontmatter.
- Recall relevant files from `wiki/memory/` before work that depends on prior context.
- Treat `raw/memory-inbox/` as untrusted Hook candidates; review before remembering.
- Preserve source traceability and update `wiki/index.md` plus `wiki/log.md` when structure changes.
<!-- LLM-WIKI:END -->
EOF
}

init_cmd() {
  NAME='My LLM Wiki'
  PURPOSE='Shared durable knowledge and project memory for people and agents.'
  LANGUAGE='English'
  AREAS='projects,concepts,decisions'
  FIELDS=''
  FORCE=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --root) [ "$#" -ge 2 ] || die '--root needs a value'; ROOT=$2; shift 2 ;;
      --name) [ "$#" -ge 2 ] || die '--name needs a value'; NAME=$2; shift 2 ;;
      --purpose) [ "$#" -ge 2 ] || die '--purpose needs a value'; PURPOSE=$2; shift 2 ;;
      --language) [ "$#" -ge 2 ] || die '--language needs a value'; LANGUAGE=$2; shift 2 ;;
      --areas) [ "$#" -ge 2 ] || die '--areas needs a value'; AREAS=$2; shift 2 ;;
      --fields) [ "$#" -ge 2 ] || die '--fields needs a value'; FIELDS=$2; shift 2 ;;
      --force) FORCE=1; shift ;;
      *) die "unknown init option: $1" ;;
    esac
  done
  absolute_root
  validate_registry_field name "$NAME"
  validate_registry_field purpose "$PURPOSE"
  validate_registry_field language "$LANGUAGE"
  validate_registry_field areas "$AREAS"
  validate_registry_field fields "$FIELDS"
  if [ -e "$ROOT/LLM-WIKI.md" ] && [ "$FORCE" -ne 1 ]; then
    die "LLM-WIKI.md already exists; use --force only when replacement is intended"
  fi
  mkdir -p "$ROOT/.llm-wiki" "$ROOT/wiki/memory" "$ROOT/raw/documents" "$ROOT/raw/repositories" "$ROOT/raw/memories"
  ensure_memory_dirs
  today=$(date +%F)
  cat > "$ROOT/.llm-wiki/config" <<EOF
version=$VERSION
name=$NAME
wiki_root=wiki
source_root=raw
language=$LANGUAGE
areas=$AREAS
fields=$FIELDS
EOF
  [ -f "$ROOT/.llm-wiki/sources.tsv" ] || printf 'type\timported_at\tsource\tdestination\n' > "$ROOT/.llm-wiki/sources.tsv"
  yaml_name=$(yaml_escape "$NAME")
  cat > "$ROOT/LLM-WIKI.md" <<EOF
# $NAME schema

$PURPOSE

## Content model

- \`wiki/\` contains curated, reusable knowledge.
- \`raw/\` contains immutable copies of imported source material.
- \`wiki/memory/\` contains reviewed long-term memories.
- \`.llm-wiki/private-inbox/\` contains private hook-captured candidates awaiting review and is ignored by Git.
- \`.llm-wiki/sources.tsv\` records source provenance.
- Preferred language: $LANGUAGE.
- Topic areas: $AREAS.

## Page schema

Every curated page uses YAML frontmatter with these fields:

- \`title\`: human-readable page title.
- \`summary\`: one or two sentences describing the durable takeaway.
- \`source\`: source path or URL.
- \`source_type\`: \`document\`, \`repo\`, \`memory\`, or \`synthesis\`.
- \`topics\`: list of stable topic labels.
- \`status\`: \`draft\`, \`active\`, or \`deprecated\`.
- \`created\` and \`updated\`: ISO dates.
EOF
  if [ -n "$FIELDS" ]; then
    printf '%s\n' "- Additional fields: $FIELDS." >> "$ROOT/LLM-WIKI.md"
  fi
  cat >> "$ROOT/LLM-WIKI.md" <<'EOF'

## Maintenance rules

- Search before creating pages; update existing knowledge when possible.
- Keep facts traceable to imported sources.
- Keep topic folders shallow and avoid empty navigation-only notes.
- Record substantial changes in `wiki/log.md`.
- Never store credentials or private auth material in the wiki.
EOF
  if [ ! -f "$ROOT/wiki/index.md" ]; then
    cat > "$ROOT/wiki/index.md" <<EOF
---
title: "$yaml_name"
summary: "Top-level navigation for $yaml_name."
source_type: synthesis
topics: [navigation]
status: active
created: $today
updated: $today
---

# $NAME

This page is the entry point for curated knowledge. Add topic links as the wiki grows.
EOF
  fi
  if [ ! -f "$ROOT/wiki/log.md" ]; then
    cat > "$ROOT/wiki/log.md" <<EOF
---
title: Maintenance log
summary: Chronological record of substantial wiki changes.
source_type: synthesis
topics: [operations]
status: active
created: $today
updated: $today
---

# Maintenance log

## $today

- Initialized $NAME and its source registry.
EOF
  fi
  if [ ! -f "$ROOT/raw/README.md" ]; then
    cat > "$ROOT/raw/README.md" <<'EOF'
# Source archive

Files below this directory are imported evidence. Keep them unchanged; put summaries and synthesis in `wiki/`.
EOF
  fi
  append_agents_block
  printf 'Initialized LLM Wiki: %s\n' "$ROOT"
}

parse_root_option() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --root) [ "$#" -ge 2 ] || die '--root needs a value'; ROOT=$2; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  absolute_root
  require_initialized
  ensure_memory_dirs
}

memory_write() {
  mode=$1
  shift
  [ "$#" -ge 1 ] || die "memory $mode needs a name"
  memory_name=$(safe_name "$1")
  shift
  content=''
  content_file=''
  summary=''
  topics=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --root) [ "$#" -ge 2 ] || die '--root needs a value'; ROOT=$2; shift 2 ;;
      --content) [ "$#" -ge 2 ] || die '--content needs a value'; content=$2; shift 2 ;;
      --file) [ "$#" -ge 2 ] || die '--file needs a value'; content_file=$2; shift 2 ;;
      --summary) [ "$#" -ge 2 ] || die '--summary needs a value'; summary=$2; shift 2 ;;
      --topics) [ "$#" -ge 2 ] || die '--topics needs a value'; topics=$2; shift 2 ;;
      *) die "unknown memory $mode option: $1" ;;
    esac
  done
  absolute_root
  require_initialized
  ensure_memory_dirs
  lock_dir="$ROOT/.llm-wiki/memory-locks/$memory_name.lock"
  mkdir -p "$ROOT/.llm-wiki/memory-locks"
  mkdir "$lock_dir" 2>/dev/null || die "memory is being modified: $memory_name"
  target=''
  temp_target=''
  trap 'rm -f "$temp_target"; rmdir "$lock_dir" 2>/dev/null || true' EXIT HUP INT TERM
  [ -z "$content" ] || [ -z "$content_file" ] || die 'use either --content or --file, not both'
  if [ -n "$content_file" ]; then
    [ -f "$content_file" ] || die "content file not found: $content_file"
    content=$(cat "$content_file")
  fi
  if [ -z "$content" ] && [ ! -t 0 ]; then content=$(cat); fi
  [ -n "$content" ] || die 'memory content is required'
  target="$ROOT/wiki/memory/$memory_name.md"
  if [ "$mode" = remember ] && [ -e "$target" ]; then die "memory exists: $memory_name; use memory update"; fi
  if [ "$mode" = update ] && [ ! -e "$target" ]; then die "memory not found: $memory_name; use memory remember"; fi
  created=$(date +%F)
  if [ -f "$target" ]; then
    existing_created=$(sed -n 's/^created: //p' "$target" | head -1)
    [ -z "$existing_created" ] || created=$existing_created
    if [ -z "$summary" ]; then summary=$(sed -n 's/^summary: "\(.*\)"$/\1/p' "$target" | head -1); fi
    if [ -z "$topics" ]; then topics=$(sed -n 's/^topics: \[\(.*\)\]$/\1/p' "$target" | head -1); fi
  fi
  [ -n "$summary" ] || summary=$(printf '%s' "$content" | tr '\n' ' ' | cut -c1-160)
  [ -n "$topics" ] || topics=general
  validate_registry_field summary "$summary"
  validate_registry_field topics "$topics"
  yaml_memory_name=$(yaml_escape "$memory_name")
  yaml_summary=$(yaml_escape "$summary")
  yaml_topics=$(printf '%s' "$topics" | sed 's/[[:space:]]*,[[:space:]]*/, /g; s/[^[:alnum:]_., -]//g')
  temp_target="$ROOT/wiki/memory/.$memory_name.$$.tmp"
  cat > "$temp_target" <<EOF
---
title: "$yaml_memory_name"
summary: "$yaml_summary"
source_type: memory
source: conversation
topics: [$yaml_topics]
status: active
created: $created
updated: $(date +%F)
---

# $memory_name

$content
EOF
  mv "$temp_target" "$target"
  temp_target=''
  case "$mode" in remember) verb=Remembered ;; update) verb=Updated ;; esac
  printf '\n## %s\n\n- %s long-term memory: \`wiki/memory/%s.md\`.\n' "$(date +%F)" "$verb" "$memory_name" >> "$ROOT/wiki/log.md"
  rmdir "$lock_dir"
  lock_dir=''
  trap - EXIT HUP INT TERM
  printf '%s memory: %s\n' "$verb" "wiki/memory/$memory_name.md"
}

memory_recall() {
  [ "$#" -ge 1 ] || die 'memory recall needs a query'
  query=$1
  shift
  limit=5
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --root) [ "$#" -ge 2 ] || die '--root needs a value'; ROOT=$2; shift 2 ;;
      --limit) [ "$#" -ge 2 ] || die '--limit needs a value'; limit=$2; shift 2 ;;
      *) die "unknown memory recall option: $1" ;;
    esac
  done
  case "$limit" in ''|*[!0-9]*) die '--limit must be a positive integer' ;; esac
  [ "$limit" -gt 0 ] || die '--limit must be a positive integer'
  absolute_root
  require_initialized
  ensure_memory_dirs
  matches=$(mktemp "${TMPDIR:-/tmp}/llm-wiki-recall.XXXXXX")
  trap 'rm -f "$matches"' EXIT HUP INT TERM
  normalized_query=$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')
  query_terms=$(
    {
      printf '%s' "$normalized_query" | tr -cs '[:alnum:]_-' '\n'
      printf '%s' "$normalized_query" | tr -d '[:space:]' | cut -c1-240 | sed 's/./& /g' | awk '{ for (i = 1; i < NF; i++) print $i $(i + 1) }'
    } | awk 'length($0) >= 2 && !seen[$0]++'
  )
  find "$ROOT/wiki/memory" -type f -name '*.md' -print 2>/dev/null | while IFS= read -r file; do
    score=0
    exact_count=$(grep -ioF "$normalized_query" "$file" 2>/dev/null | wc -l | tr -d ' ')
    score=$((score + exact_count * 10))
    for term in $query_terms; do
      [ ${#term} -ge 2 ] || continue
      count=$(grep -ioF "$term" "$file" 2>/dev/null | wc -l | tr -d ' ')
      score=$((score + count))
    done
    [ "$score" -gt 0 ] && printf '%08d\t%s\n' "$score" "$file"
  done | sort -rn > "$matches"
  count=0
  while IFS="$(printf '\t')" read -r score file; do
    [ -n "$file" ] || continue
    count=$((count + 1))
    printf '\n## %s\n\n' "$(basename "$file" .md)"
    sed -n '/^---$/,/^---$/d; /^# /d; p' "$file" | sed '/^[[:space:]]*$/d'
    [ "$count" -ge "$limit" ] && break
  done < "$matches"
  rm "$matches"
  trap - EXIT HUP INT TERM
}

memory_inbox() {
  [ "$#" -ge 1 ] || die 'memory inbox needs a file path or - for stdin'
  inbox_source=$1
  shift
  source_label='manual'
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --root) [ "$#" -ge 2 ] || die '--root needs a value'; ROOT=$2; shift 2 ;;
      --source) [ "$#" -ge 2 ] || die '--source needs a value'; source_label=$2; shift 2 ;;
      *) die "unknown memory inbox option: $1" ;;
    esac
  done
  absolute_root
  require_initialized
  ensure_memory_dirs
  validate_registry_field source "$source_label"
  ensure_memory_dirs
  stamp=$(date -u '+%Y%m%dT%H%M%SZ')
  target="$ROOT/.llm-wiki/private-inbox/$stamp-$$.md"
  old_umask=$(umask)
  umask 077
  {
    printf '%s\n' '---' "source: $source_label" "captured_at: $(date -u '+%Y-%m-%dT%H:%M:%SZ')" 'status: pending' '---' ''
    if [ "$inbox_source" = - ]; then cat; else [ -f "$inbox_source" ] || die "inbox source not found: $inbox_source"; cat "$inbox_source"; fi
  } > "$target"
  chmod 600 "$target"
  umask "$old_umask"
  printf 'Captured memory candidate: %s\n' ".llm-wiki/private-inbox/$(basename "$target")"
}

memory_list() {
  parse_root_option "$@"
  find "$ROOT/wiki/memory" -type f -name '*.md' -print 2>/dev/null | sort | while IFS= read -r file; do basename "$file" .md; done
}

parse_import_args() {
  SOURCE=$1
  shift
  IMPORT_NAME=''
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --root) [ "$#" -ge 2 ] || die '--root needs a value'; ROOT=$2; shift 2 ;;
      --name) [ "$#" -ge 2 ] || die '--name needs a value'; IMPORT_NAME=$2; shift 2 ;;
      *) die "unknown import option: $1" ;;
    esac
  done
  absolute_root
  require_initialized
  validate_registry_field source "$SOURCE"
  validate_registry_field name "$IMPORT_NAME"
  if [ -n "$IMPORT_NAME" ]; then
    IMPORT_NAME=$(safe_name "$IMPORT_NAME")
  else
    IMPORT_NAME=$(safe_name "$SOURCE")
  fi
}

record_import() {
  type=$1
  source=$2
  destination=$3
  timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  case "$source$destination" in
    *"$(printf '\t')"*|*"
"*|*"
"*) die 'tabs and newlines are not allowed in source paths' ;;
  esac
  printf '%s\t%s\t%s\t%s\n' "$type" "$timestamp" "$source" "$destination" >> "$ROOT/.llm-wiki/sources.tsv"
  printf '\n## %s\n\n- Imported %s source: \`%s\`.\n' "$(date +%F)" "$type" "$destination" >> "$ROOT/wiki/log.md"
  printf 'Imported %s: %s\n' "$type" "$destination"
}

import_document() {
  parse_import_args "$@"
  destination="$ROOT/raw/documents/$IMPORT_NAME"
  [ ! -e "$destination" ] || die "destination exists: $destination"
  case "$SOURCE" in
    http://*|https://*)
      command -v curl >/dev/null 2>&1 || die 'curl is required for URL imports'
      download="$destination.download.$$"
      trap 'rm -f "$download"' EXIT HUP INT TERM
      curl --fail --location --silent --show-error "$SOURCE" --output "$download"
      mv "$download" "$destination"
      trap - EXIT HUP INT TERM
      ;;
    *)
      [ -f "$SOURCE" ] || die "document not found: $SOURCE"
      cp "$SOURCE" "$destination"
      ;;
  esac
  record_import document "$SOURCE" "raw/documents/$IMPORT_NAME"
}

import_repo() {
  parse_import_args "$@"
  destination="$ROOT/raw/repositories/$IMPORT_NAME"
  [ ! -e "$destination" ] || die "destination exists: $destination"
  command -v git >/dev/null 2>&1 || die 'git is required for repository imports'
  mkdir "$destination"
  temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/llm-wiki.XXXXXX")
  archive="$temp_dir/repo.tar"
  trap 'rm -rf "$temp_dir" "$destination"' EXIT HUP INT TERM
  if [ -d "$SOURCE/.git" ] || git -C "$SOURCE" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$SOURCE" archive --format=tar --output="$archive" HEAD
  else
    git clone --quiet --depth 1 "$SOURCE" "$temp_dir/repo" || { rm -rf "$destination"; die "unable to clone repository: $SOURCE"; }
    git -C "$temp_dir/repo" archive --format=tar --output="$archive" HEAD
  fi
  tar -xf "$archive" -C "$destination"
  rm -rf "$temp_dir"
  trap - EXIT HUP INT TERM
  record_import repo "$SOURCE" "raw/repositories/$IMPORT_NAME"
}

import_memory() {
  parse_import_args "$@"
  destination="$ROOT/raw/memories/$IMPORT_NAME"
  [ ! -e "$destination" ] || die "destination exists: $destination"
  [ -e "$SOURCE" ] || die "memory source not found: $SOURCE"
  case "$SOURCE" in
    "$HOME"|"$HOME/"|/) die 'refusing to import an entire home or filesystem root' ;;
  esac
  if [ -f "$SOURCE" ]; then
    case "$SOURCE" in *.md|*.json|*.jsonl) mkdir "$destination"; cp "$SOURCE" "$destination/$(basename "$SOURCE")" ;; *) die 'memory imports accept only .md, .json, or .jsonl files' ;; esac
  else
    file_list=$(mktemp "${TMPDIR:-/tmp}/llm-wiki-files.XXXXXX")
    trap 'rm -f "$file_list"; rm -rf "$destination"' EXIT HUP INT TERM
    find "$SOURCE" -type f \( -name '*.md' -o -name '*.json' -o -name '*.jsonl' \) ! -name '.env' ! -path '*/.git/*' > "$file_list"
    [ -s "$file_list" ] || die 'no .md, .json, or .jsonl memory files found'
    mkdir "$destination"
    while IFS= read -r file; do
      relative=${file#"$SOURCE"/}
      mkdir -p "$destination/$(dirname "$relative")"
      cp "$file" "$destination/$relative"
    done < "$file_list"
    rm "$file_list"
    trap - EXIT HUP INT TERM
  fi
  record_import memory "$SOURCE" "raw/memories/$IMPORT_NAME"
  printf '%s\n' 'Review imported memory for credentials or private data before committing.'
}

status_cmd() {
  while [ "$#" -gt 0 ]; do
    case "$1" in --root) [ "$#" -ge 2 ] || die '--root needs a value'; ROOT=$2; shift 2 ;; *) die "unknown status option: $1" ;; esac
  done
  absolute_root
  require_initialized
  ensure_memory_dirs
  wiki_root=$(config_value wiki_root)
  source_root=$(config_value source_root)
  pages=$(find "$ROOT/$wiki_root" -type f -name '*.md' | wc -l | tr -d ' ')
  sources=$(awk 'NR > 1 { count++ } END { print count + 0 }' "$ROOT/.llm-wiki/sources.tsv")
  memories=$(find "$ROOT/wiki/memory" -type f -name '*.md' | wc -l | tr -d ' ')
  inbox=$(find "$ROOT/.llm-wiki/private-inbox" -type f -name '*.md' | wc -l | tr -d ' ')
  printf 'root: %s\nname: %s\npages: %s\nmemories: %s\ninbox: %s\nsources: %s\nsource_root: %s\n' "$ROOT" "$(config_value name)" "$pages" "$memories" "$inbox" "$sources" "$source_root"
}

command=${1:-}
[ -n "$command" ] || { usage; exit 2; }
shift
case "$command" in
  init) init_cmd "$@" ;;
  import)
    type=${1:-}; [ -n "$type" ] || die 'import type is required'; shift
    [ "$#" -ge 1 ] || die 'import source is required'
    case "$type" in document) import_document "$@" ;; repo) import_repo "$@" ;; memory) import_memory "$@" ;; *) die "unsupported import type: $type" ;; esac
    ;;
  memory)
    action=${1:-}; [ -n "$action" ] || die 'memory action is required'; shift
    case "$action" in
      remember|update) memory_write "$action" "$@" ;;
      recall) memory_recall "$@" ;;
      inbox) memory_inbox "$@" ;;
      list) memory_list "$@" ;;
      *) die "unsupported memory action: $action" ;;
    esac
    ;;
  status) status_cmd "$@" ;;
  version|--version) printf '%s\n' "llm-wiki $VERSION" ;;
  -h|--help|help) usage ;;
  *) die "unknown command: $command" ;;
esac
